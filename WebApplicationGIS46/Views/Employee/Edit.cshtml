@model EmpWithDeptListViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>
<!--url:/Employee/SaveEdit/1 formdata post{Name=,Salary=,ImageURL=,DepartmentId=} -->
<form method="post" action="/Employee/SaveEdit/@Model.Id">
   @*  <input type="hidden" name="id" value="@Model.Id" /> *@
   <div>
        <label>Name</label>
        <input type="text" class="form form-control" name="EmpName" id="EmpName" value="@Model.EmpName" />
   </div>
    <div>
        <label>Salary</label>
        <input type="number" class="form form-control" name="EmpSalary" id="EmpSalary" value="@Model.EmpSalary" />
    </div>
    <div>
        <label>ImageURL</label>
        <input type="text" class="form form-control" name="ImageURL" id="ImageURL" value="@Model.ImageURL" />
    </div>
    <div>
        <label>Department</label>
        @* <input type="number" class="form form-control" name="DepartmentId" id="DepartmentId" value="@Model.DepartmentId" /> *@
        <select  class="form form-control" name="DepartmentId" id="DepartmentId" >
            <option value="0">--Select department--</option>
            @foreach (var deptItem in Model.DepartmentList)
            {
                if (Model.DepartmentId == deptItem.Id)
                {
                    <option value="@deptItem.Id" selected>@deptItem.Name</option>
                }
                else
                {
                    <option value="@deptItem.Id">@deptItem.Name</option>
                }
            }

        </select>
    </div>
   
   <input type="submit" class="btn btn-danger" value="Save" />
   <br />
</form>
<a href="/Employee/Index">Back To List</a>
