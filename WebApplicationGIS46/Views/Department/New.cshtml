@model Department
@{
    ViewData["Title"] = "New";
}

<h1>New</h1>
<!--url :/Department/SaveNew?Name=gg&ManagerName=ahmed Get-->
<form action="/Department/SaveNew" method="post">
    <div>
        <label>Name</label>
        <input class="form form-control" name="Name" value="@Model?.Name" id="Name" type="text" />
    </div>
    <div>
        <label>Manager Name</label>
        <input class="form form-control" name="ManagerName" value="@Model?.ManagerName" id="ManagerName" type="text" />
    </div>
    <input type="submit" class="btn btn-success" value="Create" />
</form>
<br />
<a href="/Department/Index">back to List</a>
